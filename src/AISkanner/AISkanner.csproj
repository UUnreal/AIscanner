<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms Condition="'$(LinuxBygg)' != 'true'">true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AISkanner.App</RootNamespace>
    <AssemblyName>AISkanner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <Product>AI-skanner</Product>
    <Description>Finner lokal AI, skygge-AI og nettleser-AI. Leser bare.</Description>
    <Version>2.0.0</Version>
    <Company>AI-skanner (åpen kildekode)</Company>
    <Copyright>Copyright (c) 2026 Jørund og bidragsytere. MIT-lisens.</Copyright>

    <!-- Én frittstående exe: ingen .NET-installasjon, ingen PowerShell -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Ingen selvutpakking til %TEMP% og ingen komprimering: begge ligner på skadevare for antivirus -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Nødløsning for bygg på Linux uten Windows Desktop-SDK. Offisielle bygg skjer på Windows (se .github/workflows). -->
  <ItemGroup Condition="'$(LinuxBygg)' == 'true'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Include="System.Windows.Forms" />
    <Using Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <EmbeddedResource Include="ui\index.html" LogicalName="AISkanner.ui.index.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AISkanner.Core\AISkanner.Core.csproj" />
  </ItemGroup>

</Project>
