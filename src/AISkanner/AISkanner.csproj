<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bygges for .NET Framework 4.8, som følger med Windows 10 og 11.
    Da tar vi ikke med en egen .NET-motor, og hele programmet blir noen få MB, som 7-Zip.
    Størrelsesgrensen sjekkes i byggeløypa (.github/workflows/bygg.yml).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AISkanner.App</RootNamespace>
    <AssemblyName>AISkanner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>

    <Product>AI-skanner</Product>
    <Description>Finner lokal AI, skygge-AI og nettleser-AI. Leser bare.</Description>
    <Company>AI-skanner (åpen kildekode)</Company>
    <Copyright>Copyright (c) 2026 Jørund og bidragsytere. MIT-lisens.</Copyright>
    <Version>2.11.0</Version>

    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <!-- Ikke ta med dokumentasjonsfiler fra pakkene -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Using Include="System.Windows.Forms" />
    <Using Include="System.Drawing" />
    <EmbeddedResource Include="ui\index.html" LogicalName="AISkanner.ui.index.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AISkanner.Core\AISkanner.Core.csproj" />
  </ItemGroup>

  <!-- WPF-delen av WebView2 brukes ikke -->
  <Target Name="FjernUbrukt" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Microsoft.Web.WebView2.Wpf.dll" />
  </Target>

  <ItemGroup>
    <!-- YARA-reglene ligger også som åpen fil ved siden av programmet, så IT kan lese og endre dem -->
    <!-- IT sin liste over godkjent AI (blir grønt). Tom som standard. -->
    <None Include="godkjent-ai.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\AISkanner.Core\ai-modeller.yar" Link="ai-modeller.yar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
