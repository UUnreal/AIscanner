<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bygges for .NET Framework 4.8, som følger med Windows 10 og 11.
    Da tar vi ikke med en egen .NET-motor, og hele programmet blir noen få MB, som 7-Zip.
    Størrelsesgrensen sjekkes i byggeløypa (.github/workflows/bygg.yml).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AISkanner.App</RootNamespace>
    <AssemblyName>AISkanner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>

    <Product>AI-skanner</Product>
    <Description>Finner lokal AI, skygge-AI og nettleser-AI. Leser bare.</Description>
    <Company>AI-skanner (åpen kildekode)</Company>
    <Copyright>Copyright (c) 2026 Jørund og bidragsytere. MIT-lisens.</Copyright>

    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <!-- Ikke ta med dokumentasjonsfiler fra pakkene -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Ingen AISkanner.exe.config: med skjulte filendelser ser den ut som en ekstra AISkanner.exe.
      Program.AnnenVersjon gjør jobben til bindingRedirect. Byggeløypa stopper hvis en .config dukker opp igjen.
    -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Using Include="System.Windows.Forms" />
    <Using Include="System.Drawing" />
    <EmbeddedResource Include="ui\index.html" LogicalName="AISkanner.ui.index.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AISkanner.Core\AISkanner.Core.csproj" />
  </ItemGroup>

  <!--
    Én fil: alle bibliotekene (AISkanner.Core, WebView2, System.*) bakes inn i AISkanner.exe som ressurser og lastes
    fra minnet (Program.AnnenVersjon). WebView2Loader.dll er Microsofts egen lille lasterfil og må ligge på disk;
    den skrives til vindusmappa som slettes (Program.Laster). Ingen komprimering. WPF-delen av WebView2 brukes ikke.
  -->
  <Target Name="BakInn" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' And '%(Filename)' != 'Microsoft.Web.WebView2.Wpf'" LogicalName="lib.%(Filename).dll" />
      <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.2903.40/runtimes/win-x64/native/WebView2Loader.dll" LogicalName="lib.native.WebView2Loader.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(NuGetPackageRoot)microsoft.web.webview2/1.0.2903.40/runtimes/win-x64/native/WebView2Loader.dll')" Text="Fant ikke WebView2Loader.dll" />
  </Target>
  <Target Name="FjernUbrukt" AfterTargets="Publish">
    <ItemGroup><Innbakt Include="$(PublishDir)*.dll;$(PublishDir)runtimes/**" /></ItemGroup>
    <Delete Files="@(Innbakt)" />
    <RemoveDir Directories="$(PublishDir)runtimes" />
    <Delete Files="$(PublishDir)AISkanner.exe.config" />
  </Target>

  <ItemGroup>
    <!-- YARA-reglene ligger også som åpen fil ved siden av programmet, så IT kan lese og endre dem -->
    <!-- IT sin liste over godkjent AI (blir grønt). Tom som standard. -->
    <None Include="godkjent-ai.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LES-MEG-FORST.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\AISkanner.Core\ai-modeller.yar" Link="ai-modeller.yar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Kontroller-alarmene.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
