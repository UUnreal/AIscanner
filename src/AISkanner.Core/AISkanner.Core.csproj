<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net48: det som leveres. .NET Framework 4.8 følger med Windows 10 og 11, så programmet blir bare noen få MB.
    net8.0: brukes bare til å teste skannemotoren på Linux (AISkanner.Cli).
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AISkanner</RootNamespace>
    <!-- Windows-kall er beskyttet med Plattform.ErWindows -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="regler.json" LogicalName="AISkanner.regler.json" />
    <!-- YARA-regler for AI-modeller. Åpen tekst, kan også kjøres med yara.exe -->
    <EmbeddedResource Include="ai-modeller.yar" LogicalName="AISkanner.ai-modeller.yar" />
    <EmbeddedResource Include="engelsk.txt" LogicalName="AISkanner.engelsk.txt" />
    <!-- IP-land fra DB-IP.com (CC BY 4.0), komprimert. Lages med verktoy/lag-ipland.py -->
    <EmbeddedResource Include="ipland.bin" LogicalName="AISkanner.ipland.bin" />
    <EmbeddedResource Include="ipeier.bin" LogicalName="AISkanner.ipeier.bin" />
    <InternalsVisibleTo Include="AISkanner.Cli" />
    <InternalsVisibleTo Include="AISkanner" />
  </ItemGroup>

</Project>
