<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store-pakken (MSIX). Byggeløypa (jobben «store») legger AISkanner.exe og Assets ved siden av og setter
  versjonen fra src/Directory.Build.props. Microsoft signerer pakken når den er godkjent i Store.
  Identity Name, Publisher og PublisherDisplayName skal være nøyaktig det Partner Center viser under
  «Product identity» når navnet er reservert. Til da er de plassholdere, og pakken kan ikke lastes opp.
  Ingen allowElevation: den trengs bare for automatisk admin-start, og Microsoft godkjenner den bare for partnere og
  bedrifter. Admin-søket ber om godkjenning (UAC) når brukeren trykker på det, som i AISkanner.exe.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="AISkanner.Plassholder" Publisher="CN=AISkanner-plassholder" Version="0.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>AI-skanner</DisplayName>
    <PublisherDisplayName>AI-skanner</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="nb-NO" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="AISkanner" Executable="AISkanner.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="AI-skanner" Description="Finner AI på PC-en. Leser bare, lagrer ingenting."
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Kommandolinjen: «AISkanner» virker i cmd og PowerShell. Byggeløypa tester pakken slik. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="AISkanner.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias><desktop:ExecutionAlias Alias="AISkanner.exe" /></uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- Bare oppslag i NVD (produktnavn). Ingenting annet sendes. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
